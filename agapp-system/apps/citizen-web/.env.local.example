# ============================================================
#  AGAPP Next.js Citizen Web Portal & PWA — Environment Variables
#  Template file tracked in git. Copy to .env.local for local development.
# ============================================================

# Supabase Project Credentials (Settings → API in your Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NestJS API base URL (optional)
NEXT_PUBLIC_API_URL=http://localhost:5000
