        <mxCell id="UC6-note" value="Scope is every onboarded municipality. The Super Administrator does not triage reports, process service requests or moderate citizens — those remain with the municipality's own staff." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
